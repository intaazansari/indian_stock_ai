# ══════════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in your values
#
# LOCAL DEV (no Docker)
#   PostgreSQL: install locally or use Render's free managed Postgres
#   Redis:      install locally or use Render's free managed Redis
#   Qdrant:     skip (set QDRANT_URL="" — only needed for RAG features later)
#
# RENDER DEPLOYMENT
#   DATABASE_URL and REDIS_URL are auto-injected from render.yaml.
#   Set the variables marked *** REQUIRED *** in the Render dashboard.
#   Everything else is pre-set in render.yaml.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="StockSage AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"                      # development | staging | production
DEBUG=true                                     # Set false in production

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"
ALLOWED_HOSTS='["localhost", "127.0.0.1"]'
# On Render set to: '["isa-backend.onrender.com"]'

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# LOCAL: use your local Postgres credentials
DATABASE_URL="postgresql+asyncpg://isa_user:changeme@localhost:5432/isa_db"
# RENDER: Render auto-injects this from the managed Postgres.
#   It provides postgresql:// — config.py auto-converts to postgresql+asyncpg://
#   No manual change needed.

# ─── Redis ────────────────────────────────────────────────────────────────────
# LOCAL: use your local Redis
REDIS_URL="redis://:changeme_redis_password@localhost:6379/0"
# RENDER: auto-injected from the managed Redis instance.
REDIS_CACHE_TTL=3600
AI_ANALYSIS_CACHE_TTL=86400

# ─── Qdrant (Vector Database — OPTIONAL for Phase 1) ─────────────────────────
# Leave blank to disable. Backend starts normally without it.
# To enable: sign up at https://cloud.qdrant.io (free tier: 1GB)
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_ANNUAL_REPORTS="annual_reports"
QDRANT_COLLECTION_NEWS="company_news"
QDRANT_COLLECTION_TRANSCRIPTS="earnings_transcripts"

# ─── AI — *** REQUIRED *** ────────────────────────────────────────────────────
# Using Groq (free, fast): get key at https://console.groq.com
OPENAI_API_KEY="gsk_..."                       # Your Groq key (starts with gsk_)
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_ANALYSIS_MODEL="openai/gpt-oss-120b"
OPENAI_SUMMARY_MODEL="openai/gpt-oss-120b"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Optional: separate OpenAI key for embeddings (Groq does not support embeddings)
# OPENAI_EMBEDDING_API_KEY="sk-..."

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# On Render set to: '["https://isa-frontend.onrender.com"]'

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_HOUR=20

# ─── Celery ───────────────────────────────────────────────────────────────────
# LOCAL: separate Redis DBs for broker/result isolation
CELERY_BROKER_URL="redis://:changeme_redis_password@localhost:6379/1"
CELERY_RESULT_BACKEND="redis://:changeme_redis_password@localhost:6379/2"
# RENDER: auto-injected (uses same Redis instance — db 0)

# ─── Data Sources ─────────────────────────────────────────────────────────────
NSE_BASE_URL="https://www.nseindia.com"
BSE_BASE_URL="https://api.bseindia.com"
NSE_REQUEST_DELAY_SECONDS=2

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000"
# On Render set to: https://isa-backend.onrender.com
NEXT_PUBLIC_APP_NAME="StockSage AI"
